# Neon: direct URL (migrations) and pooled URL (app on Lambda)
DATABASE_URL=
DATABASE_URL_POOLED=

# Auth.js: AUTH_SECRET from `openssl rand -base64 33`
AUTH_SECRET=
# GitHub OAuth app for localhost (callback http://localhost:3000/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub OAuth app for the deployed dev stage (loaded into SST secrets, not read by the app locally)
DEV_GITHUB_ID=
DEV_GITHUB_SECRET=

# Only for Playwright in CI. Never set in production.
# E2E_TEST_LOGIN=1
